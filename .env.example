# Server-side Gemini key, NEVER prefix with VITE_
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PORT=8787

# Optional Firebase sync — all six values required.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Use your college's verified domain in BOTH app config and Firestore rules.
VITE_CAMPUS_DOMAIN=yourcollege.edu
VITE_CAMPUS_ID=your-campus
